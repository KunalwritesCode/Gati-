# Server-side only. Never prefix these with VITE_ (that would expose them in the browser).

# Free key (no card): https://console.groq.com  -> API Keys
GROQ_API_KEY=

# Optional. Defaults shown. gpt-oss-120b has the same free quota, answers Hindi/Hinglish a little
# better, and is about half the speed.
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-20b
# AI_REASONING_EFFORT=low

# Other providers: AI_PROVIDER=openai with OPENAI_API_KEY, or AI_PROVIDER=custom with
# AI_API_KEY, AI_BASE_URL and AI_MODEL (any OpenAI-compatible chat completions API).

# Optional: comma-separated extra origins allowed to call /api/chat.
ALLOWED_ORIGINS=
